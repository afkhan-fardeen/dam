# Copy to `.env.local` for local, and set the same keys in Vercel → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FILE_API_KEY=same-as-windows-API_KEY
FILE_API_BASE_URL=https://your-ngrok-or-file-api-host
NEXT_PUBLIC_FILE_API_BASE_URL=https://your-ngrok-or-file-api-host
# Shared secret for Windows → Next sync (must match windows SYNC_SERVICE_KEY)
SYNC_SERVICE_KEY=generate-a-long-random-secret
SUPABASE_DB_PASSWORD=your-db-password
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
